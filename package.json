{
  "name": "relayos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/cli.ts up",
    "db:rollback": "node --env-file-if-exists=.env --import tsx packages/db/src/cli.ts down",
    "db:seed": "node --env-file-if-exists=.env --import tsx apps/worker/src/seed.ts",
    "dev": "npm run dev -w @relayos/web",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "build": "npm run build -w @relayos/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @relayos/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "pg": "^8.23.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  }
}
