# Safe local placeholders. Never commit real secrets.
NODE_ENV=development
APP_ENV=local                      # local | staging | pilot | production
APP_BASE_URL=http://localhost:3000
APP_SECRET=dev-only-change-me-at-least-32-characters-long

# App connects as the non-superuser role (RLS applies). Migrations use the owner role.
DATABASE_URL=postgres://relayos_app:relayos_app@localhost:5432/relayos
DATABASE_ADMIN_URL=postgres://relayos:relayos@localhost:5432/relayos

# LLM: mock (default, deterministic, free) | anthropic
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Email: mock (records to outbox, never delivers)
EMAIL_PROVIDER=mock
EMAIL_FROM="RelayFlow <no-reply@example.test>"

# Stripe is off unless FEATURE_STRIPE=true. Only sk_test_ keys are accepted
# unless ALLOW_LIVE_PAYMENTS=true (a human decision).
FEATURE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOLLOWUP_KIT=
STRIPE_PRICE_RELAYOPS_SETUP=
ALLOW_LIVE_PAYMENTS=false

# Gateway limits
AGENT_DAILY_SPEND_LIMIT_USD=5
